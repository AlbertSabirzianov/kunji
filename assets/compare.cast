[12.9348, "o", "\u001b[38;2;75;75;75m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\r\n\u001b[38;2;75;75;75m\u2502\u001b[0m                                                                                          \u001b[38;2;75;75;75m\u2502\u001b[0m\r\n\u001b[38;2;75;75;75m\u2502\u001b[0m  \u001b[1;38;2;11;11;11;48;2;236;236;236m anthropic:claude-sonnet-4-5 \u001b[0m                                                           \u001b[38;2;75;75;75m\u2502\u001b[0m\r\n\u001b[38;2;75;75;75m\u2502\u001b[0m                                                                                          \u001b[38;2;75;75;75m\u2502\u001b[0m\r\n\u001b[38;2;75;75;75m\u2502\u001b[0m    Keys stay on my desk,                                                                 \u001b[38;2;75;75;75m\u2502\u001b[0m\r\n\u001b[38;2;75;75;75m\u2502\u001b[0m    every model one prompt away,                                                          \u001b[38;2;75;75;75m\u2502\u001b[0m\r\n\u001b[38;2;75;75;75m\u2502\u001b[0m    the bill: two paise.                                                                  \u001b[38;2;75;75;75m\u2502\u001b[0m\r\n\u001b[38;2;75;75;75m\u2502\u001b[0m                                                                                          \u001b[38;2;75;75;75m\u2502\u001b[0m\r\n\u001b[38;2;75;75;75m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25